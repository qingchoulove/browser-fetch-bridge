{
  "manifest_version": 3,
  "name": "Browser Fetch Bridge",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Run caller-provided fetch requests through a local browser bridge.",
  "permissions": [
    "alarms",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Browser Fetch Bridge",
    "default_popup": "popup.html"
  }
}
